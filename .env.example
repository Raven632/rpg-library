# ============================================================================
# RPG Library — пример настроек.
# Скопируйте файл и заполните значения:   cp .env.example .env
# Сам .env в репозиторий не попадает (см. .gitignore): в нём ваши секреты.
# ============================================================================

# --- Docker Compose ---------------------------------------------------------

# Порт, на котором сайт доступен снаружи. Внутри контейнера всегда 3000.
HTTP_PORT=80

# Где на хост-машине лежат игры. Эта папка монтируется в контейнер как /games.
GAMES_HOST_DIR=./games

# Имя проекта Compose. Разные имена (например rpg-prod и rpg-dev) позволяют
# держать на одном сервере прод и среду разработки, не смешивая контейнеры.
COMPOSE_PROJECT_NAME=rpg-prod

# --- Сервер -----------------------------------------------------------------

# Порт внутри контейнера. Менять не нужно.
PORT=3000

# Ключ подписи сессии. Задайте свой:   openssl rand -hex 64
# Если оставить пустым, сервер один раз сгенерирует ключ и сохранит его в базу.
# Свой ключ важен при переезде: иначе восстановление из бэкапа на другой
# машине завершит все сессии.
SESSION_SECRET=

# Имя cookie авторизации. Cookie не различают порты, поэтому прод и дев
# на одном хосте обязаны использовать разные имена, иначе вход в одно
# окружение будет выбрасывать вас из другого.
AUTH_COOKIE_NAME=auth_token

# Адрес Redis — в нём кэшируется список игр. В Compose поднимается сервисом redis
# и наружу не публикуется.
REDIS_URL=redis://redis:6379

# --- Пути (по умолчанию вычисляются от GAMES_DIR, менять обычно не нужно) ----

GAMES_DIR=/games
# SAVES_DIR=/games/_saves
# EXTRACT_TMP=/games/_tmp_uploads
# AUDIOCACHE=/games/.audio-cache

# --- Сбор метаданных --------------------------------------------------------

# Ключ ScraperAPI (1000 бесплатных кредитов в месяц): через него открываются страницы
# itch.io — сервер туда напрямую не пускают. Страница стоит 10 кредитов. Без ключа
# нет только данных с itch.io: VNDB и Steam ищутся и так.
SCRAPER_API_KEY=

# Потолок ScraperAPI за день — в кредитах, по цене, которую он сам сообщает.
# 1000 кредитов в месяц — это около 33 в день; потолок не даёт одному тяжёлому дню
# (поиск данных для всей библиотеки, листание itch.io) съесть месячный запас. Запрос
# дороже остатка ScraperAPI не выполняет и не списывает. По умолчанию 30.
# SCRAPER_DAILY_LIMIT=30

# --- Игры на своём адресе ----------------------------------------------------

# Порт, на котором открываются игры. Код игры чужой, поэтому он работает отдельно от библиотеки:
# без её входа и её API, только со своими файлами и сейвами. Порт должен быть доступен так же,
# как HTTP_PORT (в домашней сети, в Tailscale). По умолчанию 8081.
# GAME_PORT=8081

# off — игры по-старому, на адресе библиотеки. Только если на каком-то устройстве игры в
# рамке не работают: так они снова получают доступ ко всему.
# GAME_ISOLATION=off

# --- Telegram ---------------------------------------------------------------

# Токен своего бота: в Telegram откройте @BotFather, отправьте /newbot — он выдаст токен.
# Потом в библиотеке: меню «⋯» → «Telegram» → «Подключить». Бот присылает готовые загрузки,
# копию базы и сейвов раз в день и проблемы сервера — без звука, кроме проблем.
# Это секрет: с токеном пишут от имени бота.
TELEGRAM_BOT_TOKEN=

# Чат, куда писать, если не хочется подключать его из библиотеки. Обычно пусто.
# TELEGRAM_CHAT_ID=

# Пароль для копии, которая уходит в Telegram: с ним это архив 7z, где под паролем и
# содержимое, и имена файлов. Без него — обычный zip. Забудете пароль — копия бесполезна.
# BACKUP_PASSWORD=

# Сколько гигабайт свободного места — уже «мало»: тогда придёт предупреждение. По умолчанию 10.
# DISK_WARN_GB=10

# --- Проверка совместимости игр (docker compose run --rm compat) ------------

# Учётные данные существующего пользователя: тест заходит на сайт
# и по очереди открывает каждую игру.
COMPAT_USER=
COMPAT_PASS=
